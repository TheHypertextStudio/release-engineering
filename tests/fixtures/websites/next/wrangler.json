{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "name": "studio-next-fixture",
  "main": "worker.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "base_dir": ".",
  "find_additional_modules": true,
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ],
      "fallthrough": true
    },
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/__studio/release"
    ]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "studio-next-fixture-staging",
      "vars": {
        "STUDIO_SOURCE_SHA": "",
        "STUDIO_ARTIFACT_SHA256": "",
        "STUDIO_CANDIDATE_ID": ""
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        "run_worker_first": [
          "/__studio/release"
        ]
      }
    },
    "production": {
      "name": "studio-next-fixture-production",
      "vars": {
        "STUDIO_SOURCE_SHA": "",
        "STUDIO_ARTIFACT_SHA256": "",
        "STUDIO_CANDIDATE_ID": ""
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        "run_worker_first": [
          "/__studio/release"
        ]
      }
    }
  }
}
