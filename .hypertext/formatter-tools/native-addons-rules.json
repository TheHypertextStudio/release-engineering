{
  "setup": [
    ["python3", "{repo}/.hypertext/formatter-tools/native-addons.py", "setup-swift"],
    ["python3", "{repo}/.hypertext/formatter-tools/native-addons.py", "setup-terraform"]
  ],
  "rules": [
    {
      "name": "SwiftFormat",
      "patterns": ["**/*.swift", "*.swift"],
      "argv": [
        "python3",
        "{repo}/.hypertext/formatter-tools/native-addons.py",
        "swift",
        "--path",
        "{path}"
      ]
    },
    {
      "name": "Terraform",
      "patterns": ["**/*.tf", "*.tf", "**/*.tfvars", "*.tfvars", "**/*.hcl", "*.hcl"],
      "argv": [
        "python3",
        "{repo}/.hypertext/formatter-tools/native-addons.py",
        "terraform",
        "--path",
        "{path}"
      ]
    }
  ]
}
